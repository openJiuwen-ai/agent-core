"""HarnessProtocol implementation running the __DISPLAY__ CLI once per turn.

The CLI has no long-lived mode this adapter can drive, so each external Turn
is one invocation: the prompt goes in through argv (or stdin), structured
records come out on stdout until the process exits, and the vendor's own
session id carries the conversation from one invocation to the next.  Abort
terminates the running invocation; there is nothing to steer.
"""

from __future__ import annotations

import asyncio
import os

from openjiuwen.harness_protocol import (
    PROTOCOL_VERSION,
    AbortMode,
    CheckpointReason,
    HarnessCapability,
    HarnessCard,
    HarnessContext,
    HarnessProtocolError,
    HostCapability,
    ResumePolicy,
    TurnEventKind,
    TurnResult,
    UnsupportedHarnessCapabilityError,
)
from openjiuwen.harness_providers.base import PendingTurn, ProviderStartupError, SerializedTurnHarness, TurnTiming
from openjiuwen.harness_providers.inputs import harness_input_text
from openjiuwen.harness_providers.skills import install_skills
from __PKG__.bundled import select_executable
from __PKG__.config import __CLASS__HarnessConfig
from __PKG__.failure_classifier import classify_exception, turn_error
from __PKG__.mapping import PROVIDER_NAME, MappedEvent, __CLASS__TurnAccumulator
from __PKG__.process import (
    CliLaunch,
    CliLaunchError,
    CliProcess,
    CliProtocolError,
    resolve_executable,
)

ADAPTER_VERSION = "0.1.0"
# SCAFFOLD(skills-dir): the project-relative directory this CLI discovers
# skills in (e.g. ".opencode/skills"); ``None`` when it has none, in which
# case configured skills are rejected instead of silently ignored.
SKILLS_SCAN_DIR: str | None = None
# SCAFFOLD(argv): how one turn's invocation names the session, the model and
# the prompt. ``{session_id}`` / ``{model}`` are substituted. Leave
# SESSION_ARGS empty when the CLI cannot continue a session by id (every turn
# then starts a fresh conversation; do not declare PERSISTENT_SESSION).
SESSION_ARGS: tuple[str, ...] = ("--session", "{session_id}")
MODEL_ARGS: tuple[str, ...] = ("--model", "{model}")
# The option the prompt is the value of, e.g. ("-p",); empty when the prompt
# is a trailing positional argument. It always directly precedes the prompt.
PROMPT_FLAG: tuple[str, ...] = ()
# SCAFFOLD(prompt-delivery): True writes the prompt to stdin, which has no
# length limit; False passes it as the last argv element, which Windows caps
# at 32767 characters for the whole command line.
PROMPT_VIA_STDIN = False
# The host system prompt rides on the first turn of a fresh session.
_SYSTEM_PROMPT_FENCE = "<system-instructions>\n{prompt}\n</system-instructions>\n\n"


class __CLASS__Harness(SerializedTurnHarness):
    """Adapt the __DISPLAY__ CLI, invoked once per turn, to protocol v1."""

    card = HarnessCard(
        name=PROVIDER_NAME,
        implementation_version=ADAPTER_VERSION,
        protocol_version=PROTOCOL_VERSION,
        compatible_protocol_versions=frozenset({PROTOCOL_VERSION}),
        # SCAFFOLD(capabilities): FORCE_ABORT holds by construction (the adapter
        # owns the process). PERSISTENT_SESSION + CHECKPOINT only when
        # SESSION_ARGS really continues a conversation across invocations.
        capabilities=frozenset({HarnessCapability.FORCE_ABORT}),
        optional_host_capabilities=frozenset({HostCapability.CHECKPOINT_SINK}),
    )

    def __init__(self, config: __CLASS__HarnessConfig | None = None) -> None:
        """Bind the provider configuration; nothing is launched until a turn runs.

        Args:
            config: Provider-owned options; defaults invoke ``__BINARY__``.
        """
        self._config = config or __CLASS__HarnessConfig()
        super().__init__(event_buffer_capacity=self._config.event_buffer_capacity)
        self._process: CliProcess | None = None
        self._cwd: str | None = None
        self._env: dict[str, str] = {}
        self._executable = ""
        self._prelude = ""

    # ------------------------------------------------------------------
    # Provider hooks
    # ------------------------------------------------------------------

    def _validate_context(self, context: HarnessContext) -> None:
        super()._validate_context(context)
        resumes = context.resume_policy is ResumePolicy.REQUIRE_RESUME or context.checkpoint is not None
        if resumes and not self.card.supports(HarnessCapability.CHECKPOINT):
            raise UnsupportedHarnessCapabilityError("__DISPLAY__ cannot restore protocol checkpoints")
        if context.mcp_servers:
            # SCAFFOLD(mcp-config): a one-shot CLI mounts MCP servers through its
            # own config file or flags; translate them before accepting any.
            raise UnsupportedHarnessCapabilityError("__DISPLAY__ cannot mount host MCP servers")
        if self._config.skills and SKILLS_SCAN_DIR is None:
            raise UnsupportedHarnessCapabilityError("__DISPLAY__ has no skill discovery directory for portable skills")
        if self._config.model is not None and not MODEL_ARGS:
            raise UnsupportedHarnessCapabilityError("__DISPLAY__ cannot select a model")

    async def _open_session(self, context: HarnessContext) -> str | None:
        cwd = os.path.abspath(context.cwd or self._config.cwd or os.getcwd())
        if self._config.skills:
            await asyncio.to_thread(
                install_skills,
                self._config.skills,
                provider=PROVIDER_NAME,
                cwd=cwd,
                conflict=self._config.skill_conflict,
                scan_dir=SKILLS_SCAN_DIR,
            )
        env = self._child_env(context)
        try:
            executable = select_executable(self._config.cli_path, self._config.command[0], env)
            # Fail at start, not at the first turn, when the CLI is missing.
            self._executable = resolve_executable(executable, env)
        except CliLaunchError as exc:
            error = turn_error(str(exc), category="process_start_failed", sdk_error_type=type(exc).__name__)
            raise ProviderStartupError("__DISPLAY__ CLI is not available", error=error) from exc
        restored = self._restored_checkpoint_data(context)
        restored_id = restored.get("session_id") if restored else None
        if not isinstance(restored_id, str) or not restored_id:
            restored_id = None
        if context.resume_policy is ResumePolicy.REQUIRE_RESUME and restored_id is None:
            raise HarnessProtocolError("__DISPLAY__ checkpoint does not carry a session id to resume")
        self._cwd = cwd
        self._env = env
        session_id = restored_id if context.resume_policy is not ResumePolicy.NEW else None
        self._prelude = "" if session_id else self._system_prelude(context)
        return session_id

    async def _close_session(self) -> None:
        process = self._process
        self._process = None
        if process is not None:
            await process.terminate(self._config.shutdown_timeout_s)

    async def _execute_turn(self, turn: PendingTurn) -> tuple[TurnEventKind, TurnResult]:
        timing = TurnTiming()
        accumulator = __CLASS__TurnAccumulator(turn_id=turn.turn_id)
        if turn.abort_requested:
            return TurnEventKind.ABORTED, accumulator.build_interrupted_result(turn, timing=timing)
        text = self._prelude + harness_input_text(turn.content)
        process = CliProcess(max_line_bytes=self._config.max_line_bytes)
        self._process = process
        try:
            await process.start(CliLaunch(argv=self._argv(text), env=self._env, cwd=self._cwd))
            if turn.abort_requested:
                # The abort landed before the process existed to receive it.
                await process.terminate(self._config.shutdown_timeout_s)
            if PROMPT_VIA_STDIN:
                await process.write_line(text)
            await process.close_stdin()
            await self._pump(turn, process, accumulator)
            exit_code = await process.shutdown(self._config.shutdown_timeout_s)
        except asyncio.CancelledError:
            raise
        except asyncio.TimeoutError:
            await process.terminate(self._config.shutdown_timeout_s)
            await self._emit_mapped(turn, accumulator.finish())
            error = turn_error(
                f"__DISPLAY__ printed nothing for {self._config.turn_idle_timeout_s:g}s",
                category="network_timeout",
                code="__UPPER___TURN_IDLE_TIMEOUT",
            )
            return TurnEventKind.FAILED, accumulator.build_failed_result(error, timing=timing)
        except (CliLaunchError, CliProtocolError, OSError) as exc:
            await process.terminate(self._config.shutdown_timeout_s)
            await self._emit_mapped(turn, accumulator.finish())
            if turn.abort_requested:
                return TurnEventKind.ABORTED, accumulator.build_interrupted_result(turn, timing=timing)
            if isinstance(exc, CliLaunchError):
                error = turn_error(str(exc), category="process_start_failed", sdk_error_type=type(exc).__name__)
            else:
                error = classify_exception(exc)
            return TurnEventKind.FAILED, accumulator.build_failed_result(error, timing=timing)
        finally:
            if self._process is process:
                self._process = None
        if turn.abort_requested:
            await self._emit_mapped(turn, accumulator.finish())
            return TurnEventKind.ABORTED, accumulator.build_interrupted_result(turn, timing=timing)
        accumulator.close_stream(exit_code=exit_code)
        await self._emit_mapped(turn, accumulator.finish())
        # The first invocation of a fresh session carried the prelude.
        self._prelude = ""
        await self._adopt_session_id(accumulator.session_id)
        return accumulator.build_terminal_result(turn=turn, timing=timing)

    async def _interrupt_turn(self, turn: PendingTurn, mode: AbortMode) -> None:
        _ = turn, mode
        process = self._process
        if process is not None:
            await process.terminate(self._config.shutdown_timeout_s)

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------

    async def _pump(self, turn: PendingTurn, process: CliProcess, accumulator: __CLASS__TurnAccumulator) -> None:
        """Map stdout records until EOF (or an explicit end-of-turn record)."""
        while not accumulator.ended:
            record = await asyncio.wait_for(process.read_record(), self._config.turn_idle_timeout_s)
            if record is None:
                return
            await self._emit_mapped(turn, accumulator.consume(record))

    async def _emit_mapped(self, turn: PendingTurn, mapped: list[MappedEvent]) -> None:
        for event in mapped:
            await self._emit(event.payload, turn=turn, item_id=event.item_id)

    async def _adopt_session_id(self, session_id: str | None) -> None:
        """Remember the session id the CLI reported so the next turn continues it."""
        if session_id is None or session_id == self._session_id:
            return
        self._session_id = session_id
        if self.card.supports(HarnessCapability.CHECKPOINT):
            await self._publish_checkpoint(
                {"session_id": session_id},
                reason=CheckpointReason.STATE_CHANGED,
            )

    def _argv(self, text: str) -> tuple[str, ...]:
        args: list[str] = [self._executable, *self._config.command[1:]]
        if self._config.model is not None:
            args.extend(arg.format(model=self._config.model) for arg in MODEL_ARGS)
        if self._session_id and SESSION_ARGS:
            args.extend(arg.format(session_id=self._session_id) for arg in SESSION_ARGS)
        args.extend(self._config.extra_args)
        if not PROMPT_VIA_STDIN:
            args.extend((*PROMPT_FLAG, text))
        return tuple(args)

    def _child_env(self, context: HarnessContext) -> dict[str, str]:
        env: dict[str, str] = dict(os.environ) if self._config.inherit_process_env else {}
        env.update(self._config.env)
        env.update(context.env)
        return env

    @staticmethod
    def _system_prelude(context: HarnessContext) -> str:
        # SCAFFOLD(system-prompt): prefer the CLI's own system-prompt flag or
        # file when it has one; the fenced prelude is the portable fallback.
        if not context.system_prompt:
            return ""
        return _SYSTEM_PROMPT_FENCE.format(prompt=context.system_prompt)


__all__ = ["ADAPTER_VERSION", "MODEL_ARGS", "PROMPT_FLAG", "PROMPT_VIA_STDIN", "SESSION_ARGS", "__CLASS__Harness"]
