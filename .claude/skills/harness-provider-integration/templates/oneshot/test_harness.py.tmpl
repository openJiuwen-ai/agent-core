logger = logging.getLogger(__name__)
FAKE_CLI = Path(__file__).with_name("fake_cli.py")
TURN_TIMEOUT_S = 30.0


def _config(state: Path, **overrides: Any) -> __CLASS__HarnessConfig:
    values: dict[str, Any] = {
        "command": (sys.executable, str(FAKE_CLI)),
        "env": {"FAKE_CLI_STATE": str(state)},
        "shutdown_timeout_s": 2.0,
    }
    values.update(overrides)
    return __CLASS__HarnessConfig(**values)


def _context(tmp_path: Path, **overrides: Any) -> HarnessContext:
    values: dict[str, Any] = {
        "agent_name": "worker",
        "agent_id": "agent-1",
        "host_session_id": "host-1",
        "system_prompt": "",
        "cwd": str(tmp_path),
    }
    values.update(overrides)
    return HarnessContext(**values)


def _state(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


async def _turn(harness: HarnessProtocol, turn_id: str) -> list[HarnessEvent]:
    async def _collect() -> list[HarnessEvent]:
        return [event async for event in harness.turn_events(turn_id)]

    return await asyncio.wait_for(_collect(), TURN_TIMEOUT_S)


def _terminal(events: list[HarnessEvent]) -> TurnLifecycleEvent:
    payload = events[-1].event
    assert isinstance(payload, TurnLifecycleEvent)
    return payload


def _of_type(events: list[HarnessEvent], kind: type) -> list[Any]:
    return [event.event for event in events if isinstance(event.event, kind)]


def test_config_validates_and_rejects_unknown_fields() -> None:
    config = __CLASS__HarnessConfig.from_mapping({"command": ["x", "run"], "extra_args": ["--quiet"]})
    assert config.extra_args == ("--quiet",)
    with pytest.raises(ValueError, match="unknown"):
        __CLASS__HarnessConfig.from_mapping({"nope": 1})
    with pytest.raises(ValueError):
        __CLASS__HarnessConfig(shutdown_timeout_s=0)


def test_provider_creates_an_unstarted_harness_without_launching() -> None:
    provider = __CLASS__HarnessProvider()
    harness = provider.create({"command": ["definitely-not-installed-cli"]})
    assert isinstance(harness, HarnessProtocol)
    assert harness.state is HarnessState.TERMINATED


@pytest.mark.asyncio
async def test_missing_cli_fails_start_as_process_start_failed(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json", command=("definitely-not-installed-cli",)))
    with pytest.raises(ProviderStartupError) as caught:
        await harness.start(_context(tmp_path))
    assert caught.value.error.category == "process_start_failed"
    assert harness.state is HarnessState.TERMINATED


@pytest.mark.asyncio
async def test_text_turn_maps_outputs_usage_and_session(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    harness = __CLASS__Harness(_config(state))
    await harness.start(_context(tmp_path, system_prompt="Be terse."))
    try:
        receipt = await harness.send(HarnessInput(content="hello"))
        events = await _turn(harness, receipt.turn_id)
        logger.info("text turn events: %s", [type(event.event).__name__ for event in events])
        terminal = _terminal(events)
        assert terminal.kind is TurnEventKind.FINISHED, terminal.result
        assert terminal.result.final_output == "echo: hello"
        answer = [output for output in _of_type(events, OutputEvent) if output.channel is OutputChannel.ANSWER]
        assert [output.operation for output in answer][-1] is OutputOperation.FINAL
        assert terminal.result.usage.input_tokens == 10
        # The banner line the CLI printed is kept, not dropped.
        assert any(event.event_type == "__non_json_line__" for event in _of_type(events, ProviderEvent))
        assert harness.provider_session_id is not None

        second = await harness.send(HarnessInput(content="again"))
        await _turn(harness, second.turn_id)
        invocations = _state(state)["invocations"]
        assert "Be terse." in invocations[0][-1]
        assert "Be terse." not in invocations[1][-1]
    finally:
        await harness.stop()


@pytest.mark.asyncio
@pytest.mark.skipif(not SESSION_ARGS, reason="the CLI cannot continue a session by id")
async def test_later_turns_continue_the_reported_session(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    harness = __CLASS__Harness(_config(state))
    await harness.start(_context(tmp_path))
    try:
        first = await harness.send(HarnessInput(content="REMEMBER zebra"))
        await _turn(harness, first.turn_id)
        second = await harness.send(HarnessInput(content="RECALL"))
        assert _terminal(await _turn(harness, second.turn_id)).result.final_output == "recall: zebra"
    finally:
        await harness.stop()


@pytest.mark.asyncio
async def test_tool_items_pair_on_one_item_id(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="TOOL read"))
        events = await _turn(harness, receipt.turn_id)
        items = [event for event in events if isinstance(event.event, ItemLifecycleEvent)]
        assert [event.event.kind for event in items] == [ItemEventKind.STARTED, ItemEventKind.COMPLETED]
        assert items[0].item_id == items[1].item_id == "call_1"
        assert items[0].event.data["arguments"] == {"path": "secret.txt"}
        assert items[1].event.data["rendered_result"] == "TOKEN-1"
    finally:
        await harness.stop()


@pytest.mark.asyncio
async def test_follow_up_turns_run_serially(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        first = await harness.send(HarnessInput(content="one"))
        second = await harness.send(HarnessInput(content="two"))
        assert second.accepted_mode is DeliveryMode.FOLLOW_UP
        first_events = await _turn(harness, first.turn_id)
        second_events = await _turn(harness, second.turn_id)
        assert _terminal(second_events).result.final_output == "echo: two"
        assert max(event.sequence for event in first_events) < min(event.sequence for event in second_events)
    finally:
        await harness.stop()


@pytest.mark.asyncio
async def test_vendor_error_record_fails_with_the_shared_category(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="FAILREC"))
        terminal = _terminal(await _turn(harness, receipt.turn_id))
        assert terminal.kind is TurnEventKind.FAILED
        assert terminal.result.error.category == "rate_limited"
        assert terminal.result.error.retryable is True
    finally:
        await harness.stop()


