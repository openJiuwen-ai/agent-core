@pytest.mark.asyncio
@pytest.mark.skipif(
    not __CLASS__Harness.card.supports(HarnessCapability.FORCE_ABORT),
    reason="the card does not declare FORCE_ABORT",
)
async def test_abort_terminates_the_invocation(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="SLOW count"))
        events: list[HarnessEvent] = []
        aborted = False

        async def _consume() -> None:
            nonlocal aborted
            async for event in harness.turn_events(receipt.turn_id):
                events.append(event)
                if not aborted and isinstance(event.event, OutputEvent):
                    aborted = True
                    await harness.abort(mode=AbortMode.FORCE)

        await asyncio.wait_for(_consume(), TURN_TIMEOUT_S)
        terminal = _terminal(events)
        assert terminal.kind is TurnEventKind.ABORTED
        assert terminal.result.termination.kind is TurnTerminationKind.USER_ABORT
        again = await harness.send(HarnessInput(content="after"))
        assert _terminal(await _turn(harness, again.turn_id)).kind is TurnEventKind.FINISHED
    finally:
        await harness.stop()


