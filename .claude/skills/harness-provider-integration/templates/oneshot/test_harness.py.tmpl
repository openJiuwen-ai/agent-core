def _install_bundle(monkeypatch: pytest.MonkeyPatch, root: Path, target: Path) -> Path:
    """Lay out a bundled CLI whose entrypoint launches ``target`` with this interpreter."""
    bin_dir = root / "bin"
    bin_dir.mkdir(parents=True)
    launcher = bin_dir / "__BINARY__"
    launcher.write_text(f'#!/bin/sh\nexec "{sys.executable}" "{target}" "$@"\n', encoding="utf-8")
    launcher.chmod(0o755)
    metadata = {"layoutVersion": 1, "entrypoint": "bin/__BINARY__", "cliVersion": "0.0.0-test", "platform": "test"}
    (root / "runtime.json").write_text(json.dumps(metadata), encoding="utf-8")
    monkeypatch.setattr(bundled, "BUNDLED_ROOT", root)
    return bin_dir.resolve()


@pytest.mark.asyncio
@pytest.mark.skipif(os.name == "nt", reason="the bundled stand-in is a POSIX shell launcher")
async def test_bundled_cli_is_the_fallback_when_path_lacks_the_cli(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    state = tmp_path / "state.json"
    bin_dir = _install_bundle(monkeypatch, tmp_path / "_bundled", FAKE_CLI)
    harness = __CLASS__Harness(_config(state, command=("definitely-not-installed-cli",)))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="hello"))
        assert _terminal(await _turn(harness, receipt.turn_id)).result.final_output == "echo: hello"
    finally:
        await harness.stop()
    assert _state(state)["path_head"] == str(bin_dir)


@pytest.mark.asyncio
@pytest.mark.skipif(os.name == "nt", reason="the bundled stand-in is a POSIX shell launcher")
async def test_cli_path_overrides_the_bundled_cli(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    state = tmp_path / "state.json"
    bin_dir = _install_bundle(monkeypatch, tmp_path / "_bundled", tmp_path / "never-run.py")
    harness = __CLASS__Harness(_config(state, cli_path=sys.executable, command=("ignored", str(FAKE_CLI))))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="hello"))
        assert _terminal(await _turn(harness, receipt.turn_id)).result.final_output == "echo: hello"
    finally:
        await harness.stop()
    assert _state(state)["path_head"] != str(bin_dir)


@pytest.mark.asyncio
async def test_broken_fallback_bundle_fails_start(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    root = tmp_path / "_bundled"
    root.mkdir()
    (root / "runtime.json").write_text(json.dumps({"layoutVersion": 1, "entrypoint": "bin/missing"}), encoding="utf-8")
    monkeypatch.setattr(bundled, "BUNDLED_ROOT", root)
    # The bundle is consulted only when the CLI is not on PATH.
    harness = __CLASS__Harness(_config(tmp_path / "state.json", command=("definitely-not-installed-cli",)))
    with pytest.raises(ProviderStartupError) as caught:
        await harness.start(_context(tmp_path))
    assert caught.value.error.category == "process_start_failed"


