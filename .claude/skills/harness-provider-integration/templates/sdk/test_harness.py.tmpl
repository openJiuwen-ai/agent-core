@pytest.mark.asyncio
@pytest.mark.skipif(
    not __CLASS__Harness.card.supports(HarnessCapability.CHECKPOINT),
    reason="the card does not declare CHECKPOINT",
)
async def test_checkpoint_resumes_the_vendor_session(monkeypatch: pytest.MonkeyPatch) -> None:
    state = _install_fake_sdk(monkeypatch)
    first = __CLASS__Harness()
    await first.start(_context())
    receipt = await first.send(HarnessInput(content="REMEMBER zebra"))
    await _turn(first, receipt.turn_id)
    checkpoint = await first.export_checkpoint()
    await first.stop()
    second = __CLASS__Harness()
    await second.start(_context(resume_policy=ResumePolicy.REQUIRE_RESUME, checkpoint=checkpoint))
    try:
        assert state.clients[-1].session_kwargs["resume"] == checkpoint.data["session_id"]
        receipt = await second.send(HarnessInput(content="RECALL"))
        assert _terminal(await _turn(second, receipt.turn_id)).result.final_output == "recall: zebra"
    finally:
        await second.stop()


