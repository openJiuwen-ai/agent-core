@pytest.mark.asyncio
async def test_stop_aborts_queued_turns(monkeypatch: pytest.MonkeyPatch) -> None:
    _install_fake_sdk(monkeypatch)
    harness = __CLASS__Harness()
    await harness.start(_context())
    first = await harness.send(HarnessInput(content="SLOW count"))
    queued = await harness.send(HarnessInput(content="never runs"))
    events: list[HarnessEvent] = []

    async def _consume() -> None:
        async for event in harness.events():
            events.append(event)
            if isinstance(event.event, OutputEvent) and len(_of_type(events, OutputEvent)) == 1:
                asyncio.get_running_loop().create_task(harness.stop())

    await asyncio.wait_for(_consume(), TURN_TIMEOUT_S)
    terminals = {
        event.turn_id: event.event
        for event in events
        if isinstance(event.event, TurnLifecycleEvent) and event.event.kind is not TurnEventKind.STARTED
    }
    assert first.turn_id in terminals
    assert terminals[queued.turn_id].result.termination.kind is TurnTerminationKind.HARNESS_STOP


@pytest.mark.asyncio
@pytest.mark.skipif(
    not __CLASS__Harness.card.supports(HarnessCapability.GRACEFUL_ABORT),
    reason="the card does not declare GRACEFUL_ABORT",
)
async def test_abort_interrupts_the_active_turn(monkeypatch: pytest.MonkeyPatch) -> None:
    _install_fake_sdk(monkeypatch)
    harness = __CLASS__Harness()
    await harness.start(_context())
    try:
        receipt = await harness.send(HarnessInput(content="SLOW count"))
        events: list[HarnessEvent] = []
        aborted = False

        async def _consume() -> None:
            nonlocal aborted
            async for event in harness.turn_events(receipt.turn_id):
                events.append(event)
                if not aborted and isinstance(event.event, OutputEvent):
                    aborted = True
                    await harness.abort(mode=AbortMode.GRACEFUL)

        await asyncio.wait_for(_consume(), TURN_TIMEOUT_S)
        assert _terminal(events).kind is TurnEventKind.ABORTED
    finally:
        await harness.stop()


