@pytest.mark.asyncio
@pytest.mark.skipif(
    not __CLASS__Harness.card.supports(HarnessCapability.CHECKPOINT),
    reason="the card does not declare CHECKPOINT",
)
async def test_checkpoint_resume_loads_the_session_without_replaying_events(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    first = __CLASS__Harness(_config(state))
    await first.start(_context(tmp_path, system_prompt="Be terse."))
    receipt = await first.send(HarnessInput(content="REMEMBER zebra"))
    assert _terminal(await _turn(first, receipt.turn_id)).kind is TurnEventKind.FINISHED
    checkpoint = await first.export_checkpoint()
    session_id = first.provider_session_id
    await first.stop()
    assert checkpoint is not None and checkpoint.data["session_id"] == session_id

    second = __CLASS__Harness(_config(state))
    await second.start(
        _context(
            tmp_path,
            system_prompt="Be terse.",
            resume_policy=ResumePolicy.REQUIRE_RESUME,
            checkpoint=checkpoint,
        )
    )
    try:
        assert second.provider_session_id == session_id
        receipt = await second.send(HarnessInput(content="RECALL"))
        events = await _turn(second, receipt.turn_id)
        assert _terminal(events).result.final_output == "recall: zebra"
        assert not [event for event in _of_type(events, ProviderEvent) if event.event_type == "user_message_chunk"]
    finally:
        await second.stop()
    recorded = _state(state)
    assert recorded["session_load"] == [session_id]
    # A loaded session already holds the system prompt; it is not sent again.
    assert "<system-instructions>" not in recorded["prompts"][-1]


@pytest.mark.asyncio
async def test_stop_aborts_the_active_and_queued_turns(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    first = await harness.send(HarnessInput(content="SLOW count"))
    queued = await harness.send(HarnessInput(content="never runs"))
    events: list[HarnessEvent] = []

    async def _consume() -> None:
        async for event in harness.events():
            events.append(event)
            if isinstance(event.event, OutputEvent) and len(_of_type(events, OutputEvent)) == 1:
                asyncio.get_running_loop().create_task(harness.stop())

    await asyncio.wait_for(_consume(), TURN_TIMEOUT_S)
    terminals = {
        event.turn_id: event.event
        for event in events
        if isinstance(event.event, TurnLifecycleEvent) and event.event.kind is not TurnEventKind.STARTED
    }
    assert terminals[first.turn_id].kind is TurnEventKind.ABORTED
    assert terminals[queued.turn_id].result.termination.kind is TurnTerminationKind.HARNESS_STOP
    assert harness.state is HarnessState.TERMINATED


@pytest.mark.asyncio
async def test_mcp_servers_reach_session_new_in_acp_shape(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    server = McpServerConfig(name="team", transport=McpTransport.STDIO, command=("srv", "--flag"), env={"K": "V"})
    harness = __CLASS__Harness(_config(state))
    await harness.start(replace(_context(tmp_path), mcp_servers=(server,)))
    await harness.stop()
    assert _state(state)["session_new"][0]["mcpServers"] == [
