@pytest.mark.asyncio
async def test_text_turn_streams_deltas_final_and_usage(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    harness = __CLASS__Harness(_config(state))
    await harness.start(_context(tmp_path, system_prompt="Be terse."))
    try:
        receipt = await harness.send(HarnessInput(content="hello"))
        events = await _turn(harness, receipt.turn_id)
        logger.info("text turn events: %s", [type(event.event).__name__ for event in events])
        terminal = _terminal(events)
        assert terminal.kind is TurnEventKind.FINISHED, terminal.result
        assert terminal.result.final_output == "echo: hello"
        outputs = _of_type(events, OutputEvent)
        answer = [output for output in outputs if output.channel is OutputChannel.ANSWER]
        assert [output.operation for output in answer] == [
            OutputOperation.DELTA,
            OutputOperation.DELTA,
            OutputOperation.FINAL,
        ]
        assert any(output.channel is OutputChannel.REASONING for output in outputs)
        assert _of_type(events, UsageUpdatedEvent)[0].usage.input_tokens == 10
        assert terminal.result.usage.cached_input_tokens == 2
        # Chatter between prompts never becomes a turn event.
        assert not [event for event in _of_type(events, ProviderEvent) if "commands" in event.event_type]

        second = await harness.send(HarnessInput(content="again"))
        await _turn(harness, second.turn_id)
        prompts = _state(state)["prompts"]
        assert "<system-instructions>" in prompts[0] and "Be terse." in prompts[0]
        assert "<system-instructions>" not in prompts[1]
    finally:
        await harness.stop()
    assert harness.state is HarnessState.TERMINATED


@pytest.mark.asyncio
async def test_tool_call_starts_with_its_arguments_and_completes(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="TOOL read secret.txt"))
        events = await _turn(harness, receipt.turn_id)
        items = [event for event in events if isinstance(event.event, ItemLifecycleEvent)]
        assert [event.event.kind for event in items] == [ItemEventKind.STARTED, ItemEventKind.COMPLETED]
        started, completed = items
        assert started.item_id == completed.item_id
        # The pending tool_call carried no input; the item waits for it.
        assert started.event.data["arguments"] == {"filePath": "secret.txt"}
        assert started.event.data["name"] == "read"
        assert completed.event.data["rendered_result"] == "TOKEN-1"
        assert completed.event.data["result"]["output"] == "1: TOKEN-1"
        assert _terminal(events).result.final_output == "TOKEN-1"
    finally:
        await harness.stop()


@pytest.mark.asyncio
async def test_observed_requests_are_derived_from_the_stream_and_own_their_tools(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    host = frozenset({HostCapability.MODEL_REQUEST_OBSERVATION})
    await harness.start(_context(tmp_path, host_capabilities=host))
    try:
        receipt = await harness.send(HarnessInput(content="TOOL read secret.txt"))
        events = await _turn(harness, receipt.turn_id)
        observed = (ModelRequestEvent, ItemLifecycleEvent)
        kinds = [type(event.event).__name__ for event in events if isinstance(event.event, observed)]
        # Each request is reported before the tool it asked for.
        assert kinds == ["ModelRequestEvent", "ItemLifecycleEvent", "ItemLifecycleEvent", "ModelRequestEvent"]
        requests = [event.event for event in events if isinstance(event.event, ModelRequestEvent)]
        calling, answering = requests
        assert [block.kind for block in calling.output_message.content] == ["reasoning", "tool_call"]
        started = next(event for event in events if isinstance(event.event, ItemLifecycleEvent))
        call = calling.output_message.content[1]
        assert (call.data["call_id"], call.content["arguments"]) == (started.item_id, started.event.data["arguments"])
        assert [block.kind for block in answering.output_message.content] == ["reasoning", "text"]
        assert not calling.input_observed
        assert calling.ended_at <= answering.started_at
        assert calling.request_id in started.causation_ids
    finally:
        await harness.stop()


