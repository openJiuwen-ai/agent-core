@pytest.mark.asyncio
async def test_follow_up_turns_run_serially(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        first = await harness.send(HarnessInput(content="one"))
        second = await harness.send(HarnessInput(content="two"))
        assert second.accepted_mode is DeliveryMode.FOLLOW_UP
        first_events = await _turn(harness, first.turn_id)
        second_events = await _turn(harness, second.turn_id)
        assert _terminal(first_events).result.final_output == "echo: one"
        assert _terminal(second_events).result.final_output == "echo: two"
        assert max(event.sequence for event in first_events) < min(event.sequence for event in second_events)
    finally:
        await harness.stop()


@pytest.mark.asyncio
@pytest.mark.skipif(
    not __CLASS__Harness.card.supports(HarnessCapability.GRACEFUL_ABORT),
    reason="the card does not declare GRACEFUL_ABORT",
)
async def test_abort_cancels_the_prompt_and_the_session_survives(tmp_path: Path) -> None:
    harness = __CLASS__Harness(_config(tmp_path / "state.json"))
    await harness.start(_context(tmp_path))
    try:
        receipt = await harness.send(HarnessInput(content="SLOW count"))
        events: list[HarnessEvent] = []
        aborted = False

        async def _consume() -> None:
            nonlocal aborted
            async for event in harness.turn_events(receipt.turn_id):
                events.append(event)
                if not aborted and isinstance(event.event, OutputEvent):
                    aborted = True
                    await harness.abort()

        await asyncio.wait_for(_consume(), TURN_TIMEOUT_S)
        terminal = _terminal(events)
        assert terminal.kind is TurnEventKind.ABORTED
        assert terminal.result.termination.kind is TurnTerminationKind.USER_ABORT
        again = await harness.send(HarnessInput(content="after"))
        assert _terminal(await _turn(harness, again.turn_id)).kind is TurnEventKind.FINISHED
    finally:
        await harness.stop()


@pytest.mark.asyncio
async def test_permission_requests_route_to_the_host(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    requests: list[Any] = []

    class _Approvals:
        async def handle(self, request: Any) -> Any:
            requests.append(request)
            return ToolApprovalResponse(request_id=request.request_id, decision=ToolApprovalDecision.DENY)

        async def cancel(self, request_id: str, *, reason: Any = None) -> None:
            _ = request_id, reason

    harness = __CLASS__Harness(_config(state))
    context = _context(
        tmp_path,
        host_capabilities=frozenset({HostCapability.TOOL_APPROVAL}),
        interactions=_Approvals(),
    )
    await harness.start(context)
    try:
        receipt = await harness.send(HarnessInput(content="ASK to write"))
        terminal = _terminal(await _turn(harness, receipt.turn_id))
        assert terminal.result.final_output == "permission: reject"
        assert requests[0].tool_name == "write"
        assert requests[0].arguments == {"path": "a.txt"}
    finally:
        await harness.stop()
    assert _state(state)["permission"] == [{"outcome": "selected", "optionId": "reject"}]


