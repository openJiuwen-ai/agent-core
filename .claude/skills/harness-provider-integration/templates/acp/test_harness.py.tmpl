logger = logging.getLogger(__name__)
FAKE_AGENT = Path(__file__).with_name("fake_agent.py")
TURN_TIMEOUT_S = 30.0


def _config(state: Path, **overrides: Any) -> __CLASS__HarnessConfig:
    values: dict[str, Any] = {
        "command": (sys.executable, str(FAKE_AGENT)),
        "env": {"FAKE_ACP_STATE": str(state), "FAKE_ACP_MODEL_CONFIG_ID": MODEL_CONFIG_ID or "model"},
        "shutdown_timeout_s": 2.0,
        "initialize_timeout_s": 20.0,
    }
    values.update(overrides)
    return __CLASS__HarnessConfig(**values)


def _context(tmp_path: Path, **overrides: Any) -> HarnessContext:
    values: dict[str, Any] = {
        "agent_name": "worker",
        "agent_id": "agent-1",
        "host_session_id": "host-1",
        "system_prompt": "",
        "cwd": str(tmp_path),
    }
    values.update(overrides)
    return HarnessContext(**values)


def _state(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


async def _turn(harness: HarnessProtocol, turn_id: str) -> list[HarnessEvent]:
    async def _collect() -> list[HarnessEvent]:
        return [event async for event in harness.turn_events(turn_id)]

    return await asyncio.wait_for(_collect(), TURN_TIMEOUT_S)


def _terminal(events: list[HarnessEvent]) -> TurnLifecycleEvent:
    payload = events[-1].event
    assert isinstance(payload, TurnLifecycleEvent)
    return payload


def _of_type(events: list[HarnessEvent], kind: type) -> list[Any]:
    return [event.event for event in events if isinstance(event.event, kind)]


def test_config_validates_and_rejects_unknown_fields() -> None:
    config = __CLASS__HarnessConfig.from_mapping({"command": ["x", "acp"], "env": {"K": "V"}})
    assert config.command == ("x", "acp")
    with pytest.raises(ValueError, match="unknown"):
        __CLASS__HarnessConfig.from_mapping({"nope": 1})
    with pytest.raises(TypeError):
        __CLASS__HarnessConfig(command=("x", ""))
    with pytest.raises(ValueError):
        __CLASS__HarnessConfig(turn_timeout_s=0)


