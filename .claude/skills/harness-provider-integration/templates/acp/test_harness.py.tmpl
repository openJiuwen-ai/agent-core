@pytest.mark.asyncio
@pytest.mark.skipif(MODEL_CONFIG_ID is None, reason="the agent selects no model per session")
async def test_set_model_switches_the_live_session(tmp_path: Path) -> None:
    state = tmp_path / "state.json"
    harness = __CLASS__Harness(_config(state))
    await harness.start(_context(tmp_path))
    session_id = harness.provider_session_id

    await harness.set_model(ModelSelection(model="vendor/model-x"))
    current = [option.model_id for option in await harness.list_models() if option.is_default]
    with pytest.raises(HarnessProtocolError, match="vendor/missing"):
        await harness.set_model(ModelSelection(model="vendor/missing"))
    with pytest.raises(UnsupportedHarnessCapabilityError, match="effort"):
        await harness.set_model(ModelSelection(effort="high"))
    await harness.stop()

    assert current == ["vendor/model-x"]
    assert _state(state)["sessions"][session_id]["model"] == "vendor/model-x"
