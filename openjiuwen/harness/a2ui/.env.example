API_BASE=https://api.openai.com/v1
API_KEY=
MODEL_NAME=gpt-4o
MODEL_PROVIDER=OpenAI
LLM_TEMPERATURE=1.0
LLM_SEED=42
LLM_SSL_VERIFY=false

# Host/port this server binds to.
A2UI_AGENT_HOST=0.0.0.0
A2UI_AGENT_PORT=8090

# A2UI catalog referenced by createSurface messages (basic catalog by default).
A2UI_CATALOG_ID=https://a2ui.org/specification/v0_9/basic_catalog.json

# YOUTUBE_API_KEY used by video tools like `search_youtube_videos`.
#
# Get a key from https://console.cloud.google.com/ :
#   1. Create (or select) a project.
#   2. APIs & Services > Library -- enable this API on that project:
#        - YouTube Data API v3
#   3. APIs & Services > Credentials > Create Credentials > API key.
#   4. (Recommended) Under the new key's settings, set "API restrictions" to
#      only the API listed above, and set "Application restrictions" to
#      this server's IP (or referrer, if applicable) rather than leaving the
#      key unrestricted.
YOUTUBE_API_KEY=

# SERPAPI_API_KEY, shared by every SerpApi-backed tool: `search_images` (Google
# Images Light engine), `search_hotels` (Google Hotels engine),
# `search_flights` (Google Flights engine), `search_finance` (Google
# Finance engine), and `search_products` (Google Shopping engine). Empty
# means those tools report an error instead of silently returning nothing.
SERPAPI_API_KEY=

# GOOGLE_MAPS_API_KEY used by map_tools and weather_tools. 
# Empty means those tools report an error instead of silently returning nothing.
# Google Maps Platform key for `geocode_place`/`show_map` (Places API (New) +
# Maps JavaScript API must both be enabled on the project this key belongs to).
# Also used by `search_weather_forecast`/`search_weather_history` (Weather API
# must be enabled on the same project).
#
# Get a key from https://console.cloud.google.com/ :
#   1. Create (or select) a project.
#   2. APIs & Services > Library -- enable these APIs on that project:
#        - Geocoding API
#        - Maps JavaScript API
#        - Maps Static API
#        - Places API (New)
#        - Weather API
#   3. APIs & Services > Credentials > Create Credentials > API key.
#   4. (Recommended) Under the new key's settings, set "API restrictions" to
#      only the APIs listed above, and set "Application restrictions" to
#      this server's IP (or referrer, if applicable) rather than leaving the
#      key unrestricted.
GOOGLE_MAPS_API_KEY=

# Public https:// base URL the client's WebView can reach directly, used to
# build the `/map-embed` URL handed to the client (see `show_map`).
A2UI_PUBLIC_BASE_URL=
