API_BASE=https://api.openai.com/v1
API_KEY=
MODEL_NAME=gpt-4o
MODEL_PROVIDER=OpenAI
LLM_SSL_VERIFY=false

# Host/port this server binds to.
A2UI_AGENT_HOST=0.0.0.0
A2UI_AGENT_PORT=8090

# A2UI catalog referenced by createSurface messages (basic catalog by default).
A2UI_CATALOG_ID=https://a2ui.org/specification/v0_9/basic_catalog.json

# YouTube Data API v3 key for `search_youtube_videos`.
YOUTUBE_API_KEY=

# SerpApi key, shared by `search_images` (Google Images Light engine) and
# `search_hotels` (Google Hotels engine).
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_images_light
SERPAPI_LICENSES=

# Google Maps Platform key for `geocode_place`/`show_map` (Places API (New) +
# Maps JavaScript API must both be enabled on the project this key belongs to).
GOOGLE_MAPS_API_KEY=

# Public https:// base URL the client's WebView can reach directly, used to
# build the `/map-embed` URL handed to the client (see `show_map`).
A2UI_PUBLIC_BASE_URL=
